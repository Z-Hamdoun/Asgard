#======================================
#
#   Dans le terminal Ubuntu:
#       sudo apt update
#       sudo apt install default-jre
#       sudo apt install plantuml
#       wget https://github.com/plantuml/plantuml/releases/latest/download/plantuml.jar
#       mkdir -p ~/.local/bin/plantuml
#       mv plantuml.jar ~/.local/bin/plantuml/
#       echo -e '#!/bin/bash\njava -jar ~/.local/bin/plantuml/plantuml.jar "$@"' > ~/.local/bin/plantuml
#       chmod +x ~/.local/bin/plantuml
#
#
#   Dans VSCode:
#       Ctrl+Shift+P
#       Preferences: Open Settings (JSON)
#       Rajouter dans le fichier
#           "plantuml.java": "java",
#           "plantuml.jar": "/home/YOUR_USERNAME/.local/bin/plantuml/plantuml.jar",
#           "plantuml.render": "Local",
#
#   
#     Alt+D pour ouvrir la fenêtre
#         qui créé le diagramme
#      puis cliquer sur le script
#
#======================================

@startuml

title System Overview: Laptop ↔ Raspberry Pi ↔ Flight Controller

rectangle "Laptop" as Laptop
rectangle "Raspberry Pi" as RPi
rectangle "Flight Controller" as FC

Laptop --> RPi : SSH / MAVLink over Wi-Fi
RPi --> FC : UART / USB (MAVLink)

@enduml
