@startuml
hide empty description

[*] --> INIT

state INIT {
    [*] --> WAIT_FOR_GPS
    WAIT_FOR_GPS --> ARMING : gps_ok
}

ARMING --> TAKEOFF : armed
TAKEOFF --> CLIMB : altitude_reached

CLIMB --> RENDEZVOUS : ready_for_rdv
RENDEZVOUS --> FORMATION : peer_ready

FORMATION --> MISSION : start_mission
MISSION --> RETURN_HOME : mission_done

RETURN_HOME --> LAND : home_reached
LAND --> [*]

' Failsafe transitions
state FAILSAFE #red
INIT --> FAILSAFE : comm_lost
ARMING --> FAILSAFE : error
TAKEOFF --> FAILSAFE : timeout
FORMATION --> FAILSAFE : peer_lost
MISSION --> FAILSAFE : low_battery
@enduml
